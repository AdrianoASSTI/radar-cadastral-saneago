# =============================================================================
# Radar Cadastral SANEAGO — variáveis de ambiente
# Copie para `.env` e troque TODAS as senhas antes de qualquer uso fora do
# ambiente local. Valores abaixo são apenas para desenvolvimento.
# =============================================================================

# --- PostgreSQL / PostGIS ----------------------------------------------------
POSTGRES_DB=radar
POSTGRES_USER=radar_owner
POSTGRES_PASSWORD=radar_owner_dev
DB_PORT=5432

# Usuários de serviço (privilégio mínimo; ver db/init/02_usuarios.sh)
DB_PASS_API=api_dev
DB_PASS_API_SOCIAL=api_social_dev
DB_PASS_COLETOR=coletor_dev
DB_PASS_IA=ia_dev
DB_PASS_IA_SOCIAL=ia_social_dev
DB_PASS_EXPERIMENTO=experimento_dev

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=radar
RABBITMQ_PASSWORD=radar_dev
RABBITMQ_VHOST=radar
RABBITMQ_MGMT_PORT=15672
FILA_COLETA=radar.coleta
FILA_ANALISE=radar.analise
FILA_RESULTADOS=radar.resultados
PREFETCH_COUNT=4

# --- Seed --------------------------------------------------------------------
SEED_RANDOM_STATE=20261125     # semente fixa = reprodutibilidade
SEED_EXTRA_UCS=0               # UCs procedurais extras (ex.: 5000 para teste de escala)
PSEUDONIMIZACAO_SALT=troque-este-salt

# --- Armazenamento de imagens ------------------------------------------------
STORAGE_BACKEND=local          # local | s3
RETENCAO_IMAGENS_DIAS=45       # LGPD: imagens apagadas após o ciclo de análise

# --- Coleta ------------------------------------------------------------------
FONTES_IMAGEM=leiturista,mapillary,geo360
MODO_FONTES=simulado           # simulado | producao
MAPILLARY_TOKEN=
COLLECTOR_REPLICAS=1
PREFETCH_COLETOR=4
GEO360_URL_TEMPLATE=

# --- IA ----------------------------------------------------------------------
YOLO_CONF_MIN=0.35
YOLO_CONF_PRIVACIDADE=0.15
AI_WORKER_REPLICAS=1           # 8 GB de RAM: 1 réplica no dia a dia; até 4 no experimento de speedup
OMP_NUM_THREADS=2

# --- API / Frontend ----------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=troque-este-segredo

# --- Experimentos ------------------------------------------------------------
EXPERIMENTO_N_UCS=2000
EXPERIMENTO_N_TESTE=1000
EXPERIMENTO_FOLDS=5
